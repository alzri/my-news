{
  "name": "my-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && stylelint '**/*.{css,scss}'",
    "lint:fix": "eslint . --fix && stylelint '**/*.{css,scss}' --fix",
    "format": "prettier --write .",
    "prettier:test": "prettier --check .",
    "stylelint:test": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run lint && pnpm run prettier:test && pnpm run stylelint:test && pnpm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "stylelint": "^17.11.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.tsx": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
